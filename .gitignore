# ─────────────────────────────────────────────────────────────
# Repo-wide ignores shared across every project.
# Individual projects may add their own .gitignore on top of this.
# ─────────────────────────────────────────────────────────────

# OS / editor cruft
.DS_Store
.DS_Store?
._*
Thumbs.db
*.swp
*.swo

# VS Code — ignore local cruft, but keep shared per-project config
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.json
!**/.vscode/launch.json
!**/.vscode/tasks.json

# JetBrains
.idea/

# Secrets / environment
.env
secrets.toml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ipynb_checkpoints/

# Node / frontend
node_modules/
dist/
build/

# Databases (runtime artifacts)
*.db
*.sqlite
*.sqlite3

# Logs
*.log
